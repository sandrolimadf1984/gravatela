<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- ===== BARRA DE CIMA ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingTop="18dp"
        android:paddingRight="20dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GravaTela"
            android:textColor="#FF6D00"
            android:textSize="22sp"
            android:textStyle="bold|italic" />

        <ImageView
            android:id="@+id/btnConfigTopo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Definições"
            android:src="@drawable/ic_config" />
    </LinearLayout>

    <!-- ===== ATALHOS DE CIMA ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/boxBolha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circulo_cinza"
                android:contentDescription="Bola flutuante"
                android:padding="14dp"
                android:src="@drawable/ic_bolha" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bola flutuante"
                android:textColor="#6E6E73"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/boxVideos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circulo_cinza"
                android:contentDescription="Meus vídeos"
                android:padding="14dp"
                android:src="@drawable/ic_pasta" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Meus vídeos"
                android:textColor="#6E6E73"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/boxConfig"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circulo_cinza"
                android:contentDescription="Definições"
                android:padding="14dp"
                android:src="@drawable/ic_config" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Definições"
                android:textColor="#6E6E73"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EDEDF0" />

    <!-- ===== LINHA "VIDEO" + ARMAZENAMENTO ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingTop="18dp"
        android:paddingRight="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vídeo"
            android:textColor="#1C1C1E"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtArmazenamento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingLeft="14dp"
            android:paddingTop="7dp"
            android:paddingRight="14dp"
            android:paddingBottom="7dp"
            android:text="--"
            android:textColor="#FF6D00"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ===== MIOLO ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:alpha="0.25"
            android:contentDescription="Sem gravações"
            android:src="@drawable/ic_video" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Nenhuma gravação ainda"
            android:textColor="#9A9AA0"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ===== LINHA QUE APARECE SO ENQUANTO GRAVA ===== -->
    <LinearLayout
        android:id="@+id/linhaGravacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="26dp"
        android:paddingRight="26dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtTempo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="00:00:00"
            android:textColor="#1C1C1E"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPausar"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip_borda"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:text="❚❚  Pausar"
            android:textColor="#FF6D00"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== BOTAO GRAVAR ===== -->
    <TextView
        android:id="@+id/btnGravar"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginLeft="26dp"
        android:layout_marginRight="26dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_botao_gravar"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="●  Gravar"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EDEDF0" />

    <!-- ===== BARRA DE BAIXO ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/navVideo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Vídeo"
                android:src="@drawable/ic_video" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Vídeo"
                android:textColor="#FF6D00"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navVideos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:alpha="0.45"
                android:contentDescription="Meus vídeos"
                android:src="@drawable/ic_pasta" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Meus vídeos"
                android:textColor="#9A9AA0"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navConfig"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:alpha="0.45"
                android:contentDescription="Definições"
                android:src="@drawable/ic_config" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Definições"
                android:textColor="#9A9AA0"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
